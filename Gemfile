source "https://rubygems.org"

# Pins to the same gem bundle GitHub Pages uses to build the live site,
# so `bundle exec jekyll serve` matches production.
gem "github-pages", group: :jekyll_plugins

gem "webrick", "~> 1.8"

# Default gems removed from Ruby's standard library in newer Ruby versions,
# but still required by the older Jekyll pinned via github-pages.
gem "csv"
gem "logger"
gem "base64"
gem "bigdecimal"
gem "ostruct"
gem "abbrev"
